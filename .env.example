NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgresql://olist:REPLACE_LOCAL_PASSWORD@localhost:5432/olist
MCP_BEARER_TOKEN=
ADMIN_BEARER_TOKEN=
TOKEN_ENCRYPTION_KEY=
OLIST_ACCOUNT_ID=local-seller
OLIST_CLIENT_ID=
OLIST_CLIENT_SECRET=
OLIST_REDIRECT_URI=http://localhost:3000/oauth/olist/callback
OLIST_READ_RPM=30

# Escrita: desativada por padrão. Habilite somente após homologação (docs/entrega.md §14).
WRITE_MODE=disabled
# Lista separada por vírgula: stock,price,product,sku
WRITE_OPERATIONS=
# admin = humano aprova em /admin (recomendado, obrigatório em produção); client = cliente MCP confirma com código
APPROVAL_MODE=admin
PROPOSAL_TTL_MINUTES=30
MAX_BATCH_ITEMS=200
MAX_PRICE_CHANGE_PCT=30
# Só true depois de homologar PUT /produtos/{id} em produto de teste
OLIST_PRODUCT_PUT_VERIFIED=false
AUTOMATIONS_TICK_SECONDS=60

# Marketplaces (opcional; nenhum adaptador fica operacional só por ter credenciais)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
NUVEMSHOP_CLIENT_ID=
NUVEMSHOP_CLIENT_SECRET=
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
SHEIN_APP_ID=
SHEIN_APP_SECRET=

# Porta só-leitura em 127.0.0.1 para o OpenAI Secure MCP Tunnel (ChatGPT). Vazio = desativado.
TUNNEL_MCP_PORT=
